# ============================================================
# Cyvereign - Environment Configuration
# Copy this file to .env and adjust as needed.
# ============================================================

# Ollama server URL (default: localhost)
OLLAMA_BASE_URL=http://localhost:11434

# Default LLM model served by Ollama
# Recommended: deepseek-coder:6.7b  or  qwen2.5-coder:7b
LLM_MODEL=deepseek-coder:6.7b

# HuggingFace embedding model (runs locally, no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Path to ChromaDB persistent storage
CHROMA_PERSIST_DIR=./chroma_db

# NVD (National Vulnerability Database) API key - optional, increases rate limit
# Get one for free at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
